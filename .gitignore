# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Dati locali: modelli, log, database. Mai nel repository.
data/*
!data/.gitkeep
!data/logs/.gitkeep

# Risultati di benchmark: si committano solo quelli scelti, a mano
benchmarks/results/*.json
benchmarks/results/*.jsonl

# Segreti — non dovrebbero mai esistere come file, ma per sicurezza
.env
*.key
secrets.toml

# Windows
Thumbs.db
desktop.ini

# Ambiente separato per l'addestramento della wake word (vedi wakeword/README.md)
.venv-train/
wakeword/data/

# Banchi di prova: i WAV restano locali (8 ore di NFR-6 sono centinaia di MB),
# i report JSON no — sono la misura, e vanno nella storia del repository.
# wakeword/live/ fa eccezione: e' il corpus di riferimento, e un test lo usa.
wakeword/ambient/**/*.wav
wakeword/nfr7/**/*.wav

# Copertura test
.coverage
coverage.xml
htmlcov/

# Posizione della finestra: e della macchina, non del progetto.
config/settings.toml
